# Live Studio mode uses server-side YouCam credentials.
KEEPME_DEMO_MODE=false

# Server-only. Never prefix this value with NEXT_PUBLIC_.
YOUCAM_API_KEY=
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com

# Minutes until temporary session artifacts expire.
SESSION_TTL_MINUTES=30

# Set false in a public deployment. Production then fails closed if required services are absent.
KEEPME_ALLOW_EPHEMERAL=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tenant-scoped durable metadata and cleanup jobs.
DATABASE_URL=
KEEPME_AUTO_MIGRATE=false

# Private Vercel Blob storage. Provision with `vercel blob create-store --access private`.
BLOB_READ_WRITE_TOKEN=

# Clerk shopper/retailer identity and exact comma-separated retailer access list.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/signin
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signin
RETAILER_EMAIL_ALLOWLIST=

# Signed receipts, protected cleanup endpoint, and upload scanner.
RECEIPT_SIGNING_SECRET=
CRON_SECRET=
# Vercel injects MALWARE_SCAN_URL through the private scanner service binding.
# Set this URL only when deploying the scanner separately.
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=

# Dedicated MediaPipe face-landmark and person-segmentation worker.
# The private Vercel Service binding injects INTEGRITY_URL; set this override elsewhere.
INTEGRITY_WORKER_URL=
INTEGRITY_WORKER_TOKEN=

# Provider credit guards.
MAX_PROVIDER_TASKS_PER_SESSION=2
MAX_PROVIDER_TASKS_PER_HOUR=100

# AsShown beta/community gates. Use a separate database from KeepMe production.
ASSHOWN_COMMUNITY_ENABLED=false
ASSHOWN_MODERATOR_IDS=
# Exact verified Clerk email addresses allowed to moderate.
ASSHOWN_MODERATOR_EMAILS=
ASSHOWN_RETAILER_HOSTS=
# Optional, bounded text interpretation and Spanish translation directly through OpenAI.
OPENAI_API_KEY=
ASSHOWN_AI_MODEL=
# Optional garment/arrival observations; unvalidated outputs always require manual review.
ASSHOWN_VISION_MODEL=

# Incident stop: blocks new model/provider requests; saved evidence stays readable.
ASSHOWN_PAID_FEATURES_ENABLED=true
MAX_PROVIDER_TASKS_PER_DAY=100
MAX_ACCOUNT_GENERATIONS_PER_DAY=10

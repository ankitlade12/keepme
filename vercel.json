{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "integrity",
          "format": "url",
          "env": "INTEGRITY_URL"
        },
        {
          "type": "service",
          "service": "scanner",
          "format": "url",
          "env": "MALWARE_SCAN_URL"
        }
      ],
      "functions": {
        "app/api/v1/sessions/[id]/uploads/route.ts": { "maxDuration": 60 },
        "app/api/v1/sessions/[id]/[action]/route.ts": { "maxDuration": 60 },
        "app/api/internal/maintenance/route.ts": { "maxDuration": 60 }
      }
    },
    "integrity": {
      "root": "services/integrity-worker/",
      "entrypoint": "Dockerfile"
    },
    "scanner": {
      "root": "services/malware-scanner/",
      "entrypoint": "Dockerfile"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "crons": [
    { "path": "/api/internal/maintenance", "schedule": "0 2 * * *" }
  ]
}
